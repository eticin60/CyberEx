<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Logo Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="64dp">

            <TextView
                android:id="@+id/logoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CYBEREX"
                android:textColor="@color/colorAccent"
                android:textSize="48sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Web3 Wallet"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/createWalletBtn"
            style="@style/ButtonStyle.Primary"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/create_wallet"
            android:layout_marginBottom="16dp"
            app:icon="@android:drawable/ic_menu_add"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importWalletBtn"
            style="@style/ButtonStyle.Secondary"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/import_wallet"
            android:layout_marginBottom="16dp"
            app:icon="@android:drawable/ic_menu_upload"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openWalletBtn"
            style="@style/ButtonStyle.Primary"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/unlock_wallet"
            android:visibility="gone"
            app:icon="@android:drawable/ic_lock_idle_lock"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


